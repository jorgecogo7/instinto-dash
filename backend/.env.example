# Copie este arquivo para .env e preencha com as credenciais reais.
# Nenhum desses valores deve ir para o frontend nem para o Git.

PORT=4000

# --- Meta (Business Manager + System User) ---
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_API_VERSION=v21.0

# --- Google Ads (conta MCC) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_LOGIN_CUSTOMER_ID=

# --- Google Tag Manager dos clientes (ver docs/TAG_MANAGER.md) ---
# Token gerado pelo botão "Autorizar Tag Manager" (Integrações de um cliente).
# Se ficar vazio, o sistema tenta o GOOGLE_REFRESH_TOKEN (que precisa ter os
# escopos do Tag Manager).
GOOGLE_GTM_REFRESH_TOKEN=
# Só se o cliente OAuth do GOOGLE_CLIENT_ID for do tipo "App para computador"
# (Desktop): crie um cliente do tipo "Aplicativo da Web" e coloque aqui.
GOOGLE_GTM_CLIENT_ID=
GOOGLE_GTM_CLIENT_SECRET=
# Opcional. Padrão: https://api.instintodigital.com.br/api/gtm-oauth/callback
GTM_OAUTH_REDIRECT_URI=
# E-mail Google da agência, mostrado na ajuda (o cliente adiciona esse e-mail
# como usuário do contêiner com permissão Publicar).
GTM_AGENCY_EMAIL=

# --- Campanhas (criar campanhas na Meta e no Google pelo sistema) ---
# Trava geral. Enquanto não for "true", o botão Publicar não envia nada de
# verdade pras plataformas (com USE_MOCK_DATA=true a publicação é só simulada).
# Tudo é criado PAUSADO, mesmo com a trava ligada.
CAMPAIGNS_PUBLISH_ENABLED=false
# Versão da Marketing API usada só pra CRIAR campanhas na Meta.
# (A v21.0 de META_API_VERSION foi descontinuada pela Meta; vale atualizar as duas.)
META_ADS_API_VERSION=v25.0

# --- Anthropic (para as sugestões de melhoria por IA) ---
# Crie a chave em console.anthropic.com — sem ela, o endpoint /api/insights
# devolve um erro explicando que a chave falta, em vez de dado inventado.
ANTHROPIC_API_KEY=

# Quando USE_MOCK_DATA=true, os serviços retornam dados de exemplo
# em vez de chamar as APIs reais — útil enquanto as credenciais
# acima ainda não existem.
USE_MOCK_DATA=true

# --- Segurança ---
# Domínio que tem permissão de chamar essa API (CORS).
ALLOWED_ORIGIN=https://dash.instintodigital.com.br

# --- Login do dono da agência ---
# ADMIN_PASSWORD_HASH não é a senha em texto puro — é um hash gerado
# (peça pro Claude gerar um novo se precisar trocar a senha).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Chave usada pra assinar os tokens de sessão do login — string aleatória
# longa, nunca reaproveitada de outro projeto.
TOKEN_SECRET=

# --- Banco de dados (guarda os clientes cadastrados) ---
# Crie em hPanel → Banco de dados → MySQL. Sem isso, o cadastro de
# clientes não funciona (antes usava um arquivo, mas ele era apagado a
# cada deploy — por isso trocamos para um banco de verdade).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- WhatsApp (Meta Cloud API oficial) para o CRM dos clientes ---
# Token de acesso permanente de um usuário do sistema (Business Manager)
# com as permissões whatsapp_business_messaging e whatsapp_business_management.
WHATSAPP_TOKEN=
# Texto qualquer que você inventa e repete no painel da Meta ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Chave secreta do app (Meta for Developers > Configurações > Básico).
# Usada para conferir a assinatura de cada chamada do webhook.
# Se ficar vazia, o backend usa META_APP_SECRET.
WHATSAPP_APP_SECRET=
# Opcional. Padrão: v21.0
WHATSAPP_API_VERSION=
# Importante: com USE_MOCK_DATA=true nenhuma mensagem sai de verdade
# (envios ficam como "simulada"). Em produção use USE_MOCK_DATA=false.
