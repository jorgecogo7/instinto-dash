# Copie este arquivo para .env e preencha com as credenciais reais.
# Nenhum desses valores deve ir para o frontend nem para o Git.

PORT=4000

# --- Meta (Business Manager + System User) ---
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_API_VERSION=v21.0

# --- Google Ads (conta MCC) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_LOGIN_CUSTOMER_ID=

# --- Anthropic (para as sugestões de melhoria por IA) ---
# Crie a chave em console.anthropic.com — sem ela, o endpoint /api/insights
# devolve um erro explicando que a chave falta, em vez de dado inventado.
ANTHROPIC_API_KEY=

# Quando USE_MOCK_DATA=true, os serviços retornam dados de exemplo
# em vez de chamar as APIs reais — útil enquanto as credenciais
# acima ainda não existem.
USE_MOCK_DATA=true

# --- Segurança ---
# Domínio que tem permissão de chamar essa API (CORS).
ALLOWED_ORIGIN=https://dash.instintodigital.com.br

# --- Login do dono da agência ---
# ADMIN_PASSWORD_HASH não é a senha em texto puro — é um hash gerado
# (peça pro Claude gerar um novo se precisar trocar a senha).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Chave usada pra assinar os tokens de sessão do login — string aleatória
# longa, nunca reaproveitada de outro projeto.
TOKEN_SECRET=
